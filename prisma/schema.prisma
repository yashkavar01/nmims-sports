model User {
  id                    String                          @id @default(uuid())
  name                  String
  email                 String                          @unique
  role                  String                          @default("STUDENT")
  createdAt             DateTime                        @default(now())

  players               Player[]
  createdTeams          Team[]                          @relation("TeamCreator")
  teamMemberships       TeamMember[]
  registrationRequests  TournamentRegistrationRequest[] @relation("RegistrationRequester")
  reviewedRegistrations TournamentRegistrationRequest[] @relation("RegistrationReviewer")
}

model Sport {
  id                   String                @id @default(uuid())
  name                 String                @unique
  description          String?
  createdAt            DateTime              @default(now())

  teams                Team[]
  tournaments          Tournament[]
  matches              Match[]
  statisticDefinitions StatisticDefinition[]
}

model Tournament {
  id            String                          @id @default(uuid())
  name          String
  sportId       String
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime                        @default(now())

  sport         Sport                           @relation(fields:[sportId], references:[id])
  teams         TournamentTeam[]
  matches       Match[]
  registrations TournamentRegistrationRequest[]
}

model Team {
  id              String                          @id @default(uuid())
  name            String
  sportId         String
  createdById     String?
  createdAt       DateTime                        @default(now())

  sport           Sport                           @relation(fields:[sportId], references:[id])
  createdBy       User?                           @relation("TeamCreator", fields:[createdById], references:[id])

  players         Player[]
  members         TeamMember[]
  tournaments     TournamentTeam[]
  registrations   TournamentRegistrationRequest[]

  homeMatches     Match[]                         @relation("HomeTeam")
  awayMatches     Match[]                         @relation("AwayTeam")

  statisticValues StatisticValue[]
  events          MatchEvent[]

  @@index([createdById])
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  role     String   @default("PLAYER")
  joinedAt DateTime @default(now())

  team     Team     @relation(fields:[teamId], references:[id])
  user     User     @relation(fields:[userId], references:[id])

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

model Player {
  id              String           @id @default(uuid())
  userId          String
  teamId          String
  jerseyNo        Int?
  createdAt       DateTime         @default(now())

  user            User             @relation(fields:[userId], references:[id])
  team            Team             @relation(fields:[teamId], references:[id])
  statisticValues StatisticValue[]
  events          MatchEvent[]
}

model TournamentRegistrationRequest {
  id            String     @id @default(uuid())
  tournamentId  String
  teamId        String
  requestedById String?
  reviewedById  String?
  status        String     @default("PENDING")
  reason        String?
  reviewedAt    DateTime?
  createdAt     DateTime   @default(now())

  tournament    Tournament @relation(fields:[tournamentId], references:[id])
  team          Team       @relation(fields:[teamId], references:[id])

  requestedBy   User?      @relation("RegistrationRequester", fields:[requestedById], references:[id])
  reviewedBy    User?      @relation("RegistrationReviewer", fields:[reviewedById], references:[id])

  @@unique([tournamentId, teamId])
  @@index([tournamentId])
  @@index([teamId])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
}

model TournamentTeam {
  id           String     @id @default(uuid())
  tournamentId String
  teamId       String

  tournament   Tournament @relation(fields:[tournamentId], references:[id])
  team         Team       @relation(fields:[teamId], references:[id])

  @@unique([tournamentId, teamId])
}

model Match {
  id              String           @id @default(uuid())
  sportId         String
  tournamentId    String?
  homeTeamId      String
  awayTeamId      String
  scheduledAt     DateTime?
  status          String           @default("SCHEDULED")
  createdAt       DateTime         @default(now())

  sport           Sport            @relation(fields:[sportId], references:[id])
  tournament      Tournament?      @relation(fields:[tournamentId], references:[id])
  homeTeam        Team             @relation("HomeTeam", fields:[homeTeamId], references:[id])
  awayTeam        Team             @relation("AwayTeam", fields:[awayTeamId], references:[id])
  statisticValues StatisticValue[]
  events          MatchEvent[]
}

model StatisticDefinition {
  id          String           @id @default(uuid())
  sportId     String
  name        String
  code        String
  dataType    String           @default("NUMBER")
  unit        String?
  description String?
  createdAt   DateTime         @default(now())

  sport       Sport            @relation(fields:[sportId], references:[id])
  values      StatisticValue[]

  @@unique([sportId, code])
}

model StatisticValue {
  id          String              @id @default(uuid())
  matchId     String
  playerId    String?
  teamId      String?
  statisticId String
  value       Float
  createdAt   DateTime            @default(now())

  match       Match               @relation(fields:[matchId], references:[id])
  player      Player?             @relation(fields:[playerId], references:[id])
  team        Team?               @relation(fields:[teamId], references:[id])
  statistic   StatisticDefinition @relation(fields:[statisticId], references:[id])

  @@index([matchId])
  @@index([playerId])
  @@index([teamId])
  @@index([statisticId])
}

model MatchEvent {
  id        String   @id @default(uuid())
  matchId   String
  playerId  String?
  teamId    String?
  type      String
  data      String?
  timestamp DateTime @default(now())

  match     Match    @relation(fields:[matchId], references:[id])
  player    Player?  @relation(fields:[playerId], references:[id])
  team      Team?    @relation(fields:[teamId], references:[id])

  @@index([matchId])
  @@index([playerId])
  @@index([teamId])
  @@index([type])
}
