model User {
  id                       String                          @id @default(uuid())
  name                     String
  email                    String                          @unique
  role                     String                          @default("STUDENT")
  createdAt                DateTime                        @default(now())

  players                  Player[]
  createdTeams             Team[]                          @relation("TeamCreator")
  teamMemberships          TeamMember[]
  registrationRequests     TournamentRegistrationRequest[] @relation("RegistrationRequester")
  reviewedRegistrations    TournamentRegistrationRequest[] @relation("RegistrationReviewer")
  scorerAssignments        MatchScorerAssignment[]         @relation("MatchScorer")
  createdScorerAssignments MatchScorerAssignment[]         @relation("ScorerAssignmentCreator")
}

model Sport {
  id                   String                @id @default(uuid())
  name                 String                @unique
  description          String?
  createdAt            DateTime              @default(now())

  teams                Team[]
  tournaments          Tournament[]
  matches              Match[]
  statisticDefinitions StatisticDefinition[]
}

model Tournament {
  id            String                          @id @default(uuid())
  name          String
  sportId       String
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime                        @default(now())

  sport         Sport                           @relation(fields:[sportId], references:[id])
  teams         TournamentTeam[]
  matches       Match[]
  registrations TournamentRegistrationRequest[]
}

model Team {
  id              String                          @id @default(uuid())
  name            String
  sportId         String
  createdById     String?
  createdAt       DateTime                        @default(now())

  sport           Sport                           @relation(fields:[sportId], references:[id])
  createdBy       User?                           @relation("TeamCreator", fields:[createdById], references:[id])

  players         Player[]
  members         TeamMember[]
  tournaments     TournamentTeam[]
  registrations   TournamentRegistrationRequest[]

  homeMatches     Match[]                         @relation("HomeTeam")
  awayMatches     Match[]                         @relation("AwayTeam")
  winnerMatches   Match[]                         @relation("MatchWinner")
  tossWins        Match[]                         @relation("TossWinner")

  matchPlayers    MatchPlayer[]
  battingInnings  CricketInnings[]                @relation("BattingTeam")
  bowlingInnings  CricketInnings[]                @relation("BowlingTeam")
  statisticValues StatisticValue[]
  events          MatchEvent[]

  @@index([createdById])
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  role     String   @default("PLAYER")
  joinedAt DateTime @default(now())

  team     Team     @relation(fields:[teamId], references:[id])
  user     User     @relation(fields:[userId], references:[id])

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

model Player {
  id                   String            @id @default(uuid())
  userId               String
  teamId               String
  jerseyNo             Int?
  createdAt            DateTime          @default(now())

  user                 User              @relation(fields:[userId], references:[id])
  team                 Team              @relation(fields:[teamId], references:[id])

  statisticValues      StatisticValue[]
  events               MatchEvent[]

  matchPlayers         MatchPlayer[]
  bowledOvers          CricketOver[]     @relation("BowledOvers")

  strikerDeliveries    CricketDelivery[] @relation("StrikerDeliveries")
  nonStrikerDeliveries CricketDelivery[] @relation("NonStrikerDeliveries")
  bowlerDeliveries     CricketDelivery[] @relation("BowlerDeliveries")
  dismissedDeliveries  CricketDelivery[] @relation("DismissedDeliveries")
}

model TournamentRegistrationRequest {
  id            String     @id @default(uuid())
  tournamentId  String
  teamId        String
  requestedById String?
  reviewedById  String?
  status        String     @default("PENDING")
  reason        String?
  reviewedAt    DateTime?
  createdAt     DateTime   @default(now())

  tournament    Tournament @relation(fields:[tournamentId], references:[id])
  team          Team       @relation(fields:[teamId], references:[id])

  requestedBy   User?      @relation("RegistrationRequester", fields:[requestedById], references:[id])
  reviewedBy    User?      @relation("RegistrationReviewer", fields:[reviewedById], references:[id])

  @@unique([tournamentId, teamId])
  @@index([tournamentId])
  @@index([teamId])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
}

model TournamentTeam {
  id           String     @id @default(uuid())
  tournamentId String
  teamId       String

  tournament   Tournament @relation(fields:[tournamentId], references:[id])
  team         Team       @relation(fields:[teamId], references:[id])

  @@unique([tournamentId, teamId])
}

model Match {
  id                String                  @id @default(uuid())
  sportId           String
  tournamentId      String?
  homeTeamId        String
  awayTeamId        String
  winnerTeamId      String?

  scheduledAt       DateTime?
  venue             String?
  round             String?
  matchNumber       Int?

  format            String?
  maxOvers          Int?

  tossWinnerTeamId  String?
  tossDecision      String?

  status            String                  @default("SCHEDULED")
  result            String?
  createdAt         DateTime                @default(now())

  sport             Sport                   @relation(fields:[sportId], references:[id])
  tournament        Tournament?             @relation(fields:[tournamentId], references:[id])

  homeTeam          Team                    @relation("HomeTeam", fields:[homeTeamId], references:[id])
  awayTeam          Team                    @relation("AwayTeam", fields:[awayTeamId], references:[id])
  winnerTeam        Team?                   @relation("MatchWinner", fields:[winnerTeamId], references:[id])
  tossWinnerTeam    Team?                   @relation("TossWinner", fields:[tossWinnerTeamId], references:[id])

  statisticValues   StatisticValue[]
  events            MatchEvent[]

  scorerAssignments MatchScorerAssignment[]
  players           MatchPlayer[]
  innings           CricketInnings[]
  cricketConfig     CricketMatchConfig?

  @@index([sportId])
  @@index([tournamentId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([winnerTeamId])
  @@index([tossWinnerTeamId])
  @@index([status])
  @@index([scheduledAt])
}

model CricketMatchConfig {
  id                 String   @id @default(uuid())
  matchId            String   @unique

  format             String   @default("CUSTOM")
  overs              Int
  playersPerTeam     Int      @default(11)
  substitutesPerTeam Int      @default(5)
  inningsPerTeam     Int      @default(1)

  wideEnabled        Boolean  @default(true)
  noBallEnabled      Boolean  @default(true)
  byeEnabled         Boolean  @default(true)
  legByeEnabled      Boolean  @default(true)
  penaltyRunsEnabled Boolean  @default(false)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  match              Match    @relation(fields:[matchId], references:[id], onDelete: Cascade)

  @@index([format])
}

model StatisticDefinition {
  id          String           @id @default(uuid())
  sportId     String
  name        String
  code        String
  dataType    String           @default("NUMBER")
  unit        String?
  description String?
  createdAt   DateTime         @default(now())

  sport       Sport            @relation(fields:[sportId], references:[id])
  values      StatisticValue[]

  @@unique([sportId, code])
}

model StatisticValue {
  id          String              @id @default(uuid())
  matchId     String
  playerId    String?
  teamId      String?
  statisticId String
  value       Float
  createdAt   DateTime            @default(now())

  match       Match               @relation(fields:[matchId], references:[id])
  player      Player?             @relation(fields:[playerId], references:[id])
  team        Team?               @relation(fields:[teamId], references:[id])
  statistic   StatisticDefinition @relation(fields:[statisticId], references:[id])

  @@index([matchId])
  @@index([playerId])
  @@index([teamId])
  @@index([statisticId])
}

model MatchEvent {
  id        String   @id @default(uuid())
  matchId   String
  playerId  String?
  teamId    String?
  type      String
  data      String?
  timestamp DateTime @default(now())

  match     Match    @relation(fields:[matchId], references:[id])
  player    Player?  @relation(fields:[playerId], references:[id])
  team      Team?    @relation(fields:[teamId], references:[id])

  @@index([matchId])
  @@index([playerId])
  @@index([teamId])
  @@index([type])
}

model MatchScorerAssignment {
  id           String   @id @default(uuid())
  matchId      String
  scorerId     String
  assignedById String
  status       String   @default("ASSIGNED")
  assignedAt   DateTime @default(now())
  updatedAt    DateTime @default(now())

  match        Match    @relation(fields:[matchId], references:[id])
  scorer       User     @relation("MatchScorer", fields:[scorerId], references:[id])
  assignedBy   User     @relation("ScorerAssignmentCreator", fields:[assignedById], references:[id])

  @@unique([matchId, scorerId])
  @@index([matchId])
  @@index([scorerId])
  @@index([assignedById])
  @@index([status])
}

model MatchPlayer {
  id        String   @id @default(uuid())
  matchId   String
  playerId  String
  teamId    String
  role      String   @default("PLAYER")
  position  Int?
  createdAt DateTime @default(now())

  match     Match    @relation(fields:[matchId], references:[id])
  player    Player   @relation(fields:[playerId], references:[id])
  team      Team     @relation(fields:[teamId], references:[id])

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([playerId])
  @@index([teamId])
}

model CricketInnings {
  id            String            @id @default(uuid())
  matchId       String
  inningsNumber Int
  battingTeamId String
  bowlingTeamId String

  runs          Int               @default(0)
  wickets       Int               @default(0)
  legalBalls    Int               @default(0)

  target        Int?
  status        String            @default("NOT_STARTED")

  createdAt     DateTime          @default(now())

  match         Match             @relation(fields:[matchId], references:[id])
  battingTeam   Team              @relation("BattingTeam", fields:[battingTeamId], references:[id])
  bowlingTeam   Team              @relation("BowlingTeam", fields:[bowlingTeamId], references:[id])

  overs         CricketOver[]
  deliveries    CricketDelivery[]

  @@unique([matchId, inningsNumber])
  @@index([matchId])
  @@index([battingTeamId])
  @@index([bowlingTeamId])
  @@index([status])
}

model CricketOver {
  id         String            @id @default(uuid())
  inningsId  String
  overNumber Int
  bowlerId   String

  createdAt  DateTime          @default(now())

  innings    CricketInnings    @relation(fields:[inningsId], references:[id])
  bowler     Player            @relation("BowledOvers", fields:[bowlerId], references:[id])

  deliveries CricketDelivery[]

  @@unique([inningsId, overNumber])
  @@index([inningsId])
  @@index([bowlerId])
}

model CricketDelivery {
  id                String         @id @default(uuid())
  inningsId         String
  overId            String

  ballNumber        Int
  legalBall         Boolean        @default(true)

  strikerId         String
  nonStrikerId      String
  bowlerId          String

  runsOffBat        Int            @default(0)
  extras            Int            @default(0)
  totalRuns         Int            @default(0)

  extraType         String?

  wicket            Boolean        @default(false)
  wicketType        String?
  dismissedPlayerId String?

  data              String?
  createdAt         DateTime       @default(now())

  innings           CricketInnings @relation(fields:[inningsId], references:[id])
  over              CricketOver    @relation(fields:[overId], references:[id])

  striker           Player         @relation("StrikerDeliveries", fields:[strikerId], references:[id])
  nonStriker        Player         @relation("NonStrikerDeliveries", fields:[nonStrikerId], references:[id])
  bowler            Player         @relation("BowlerDeliveries", fields:[bowlerId], references:[id])
  dismissedPlayer   Player?        @relation("DismissedDeliveries", fields:[dismissedPlayerId], references:[id])

  @@index([inningsId])
  @@index([overId])
  @@index([strikerId])
  @@index([nonStrikerId])
  @@index([bowlerId])
  @@index([dismissedPlayerId])
  @@index([wicket])
}
